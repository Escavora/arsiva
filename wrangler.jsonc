{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker.mjs membungkus .open-next/worker.js dan menambah handler `scheduled`.
	"main": "worker.mjs",
	"name": "arsiva",
	"compatibility_date": "2026-10-01",
	// nodejs_compat wajib: kode memakai node:crypto (randomBytes, randomUUID).
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Referensi ke worker ini sendiri; nama service harus sama dengan "name".
			"binding": "WORKER_SELF_REFERENCE",
			"service": "arsiva"
		}
	],
	"triggers": {
		// Pengingat kedaluwarsa: 01:00–04:00 UTC (08.00–11.00 WIB), tiap jam. Satu putaran
		// memproses paling banyak 20 dokumen (batas subrequest paket gratis); putaran
		// berikutnya melanjutkan sisanya. Putaran tanpa dokumen baru hanya 1 query.
		"crons": ["0 1-4 * * *"]
	},
	"r2_buckets": [
		{
			// Berkas hasil scan dokumen. Bucket PRIVATE: berkas hanya disalurkan
			// lewat /api/documents/[id]/file dan /s/[token]/file setelah sesi/token
			// diverifikasi. Di lokal (next dev / preview) bucket disimulasikan Wrangler.
			"binding": "FILES",
			"bucket_name": "arsiva-files"
		}
	]
}
