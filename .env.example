# ARSIVA — template variabel lingkungan.
# Salin ke .env lalu isi nilainya. JANGAN taruh nilai rahasia sungguhan di sini.
# (File .env yang berisi rahasia sudah diabaikan git; file .env.example ini aman.)

# ── Database ──────────────────────────────────────────────────────────────
# Neon (Postgres). Salin connection string dari console.neon.tech — pakai yang
# "pooled" (host berakhiran -pooler). Migrasi drizzle-kit otomatis memakai host
# langsung (tanpa -pooler); timpa dengan DATABASE_URL_UNPOOLED bila perlu.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Better Auth ───────────────────────────────────────────────────────────
# Buat rahasia acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Isi dengan domain publik saat di-deploy, mis. https://arsiva.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Storage berkas ────────────────────────────────────────────────────────
# Cloudflare R2 lewat binding "FILES" di wrangler.jsonc — tidak butuh variabel
# atau kredensial di sini. Di lokal, bucket disimulasikan Wrangler.

# ── Email (log | resend | smtp) ───────────────────────────────────────────
EMAIL_DRIVER=resend
EMAIL_FROM="ARSIVA <onboarding@resend.dev>"
RESEND_API_KEY=
# SMTP (opsional, bila EMAIL_DRIVER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Cron pengingat ────────────────────────────────────────────────────────
# Buat rahasia acak seperti BETTER_AUTH_SECRET. Vercel Cron otomatis mengirim
# header Authorization: Bearer <CRON_SECRET> saat variabel ini diset.
CRON_SECRET=
